[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/components/outcome.gd" id="1"]

[node name="Outcome" type="PanelContainer"]
theme_type_variation = &"Paper"
script = ExtResource("1")

[node name="Box" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Caption"
text = "What changed"

[node name="Money" type="Label" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Display"
text = "+£0"

[node name="Energy" type="Label" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Muted"
text = "Energy"

[node name="Rule" type="HSeparator" parent="Box"]
layout_mode = 2
theme_type_variation = &"Rule"

[node name="Lines" type="VBoxContainer" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="RelTitle" type="Label" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Caption"
text = "People"

[node name="Rels" type="VBoxContainer" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 4

[node name="LearnedTitle" type="Label" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Caption"
text = "Learned"

[node name="Learned" type="VBoxContainer" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 4

[node name="Spacer" type="Control" parent="Box"]
layout_mode = 2
size_flags_vertical = 3

[node name="ContinueButton" type="Button" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Primary"
text = "Carry on"
