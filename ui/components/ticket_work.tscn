[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/components/ticket_work.gd" id="1"]

[node name="TicketWork" type="PanelContainer"]
theme_type_variation = &"Paper"
script = ExtResource("1")

[node name="Box" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Head" type="HBoxContainer" parent="Box"]
layout_mode = 2

[node name="Title" type="Label" parent="Box/Head"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Heading"
text = "Ticket 1 of 6"

[node name="Mistakes" type="Label" parent="Box/Head"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 8
theme_type_variation = &"Muted"
text = "Mistakes: 0"

[node name="Rule" type="HSeparator" parent="Box"]
layout_mode = 2
theme_type_variation = &"Rule"

[node name="Items" type="VBoxContainer" parent="Box"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 140)
layout_mode = 2
theme_override_constants/separation = 4

[node name="Rule2" type="HSeparator" parent="Box"]
layout_mode = 2
theme_type_variation = &"Rule"

[node name="Menu" type="GridContainer" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8
columns = 3
