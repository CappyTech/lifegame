[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/components/conversation.gd" id="1"]

[node name="Conversation" type="PanelContainer"]
theme_type_variation = &"Paper"
script = ExtResource("1")

[node name="Box" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Opener" type="Label" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Quote"
autowrap_mode = 3
text = "..."

[node name="TimerBar" type="ProgressBar" parent="Box"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 6)
layout_mode = 2
show_percentage = false

[node name="SilenceHint" type="Label" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Caption"
autowrap_mode = 3
text = "..."

[node name="Rule" type="HSeparator" parent="Box"]
layout_mode = 2
theme_type_variation = &"Rule"

[node name="Choices" type="VBoxContainer" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 4

[node name="Reply" type="Label" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Quote"
autowrap_mode = 3
text = "..."

[node name="ContinueButton" type="Button" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 8
text = "Carry on"
