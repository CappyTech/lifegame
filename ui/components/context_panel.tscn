[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/components/context_panel.gd" id="1"]

[node name="ContextPanel" type="PanelContainer"]
theme_type_variation = &"Paper"
script = ExtResource("1")

[node name="Box" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Title" type="Label" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Caption"
text = "Right now"

[node name="Activity" type="Label" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3
text = "Activity"

[node name="Place" type="Label" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Muted"
text = "Place"

[node name="Mood" type="Label" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Muted"
text = "Mood"

[node name="Pressures" type="VBoxContainer" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 2
