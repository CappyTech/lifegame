[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/components/route_work.gd" id="1"]

[node name="RouteWork" type="PanelContainer"]
theme_type_variation = &"Paper"
script = ExtResource("1")

[node name="Box" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Heading"
text = "The drive"

[node name="Hint" type="Label" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Muted"
text = "Which way?"

[node name="Rule" type="HSeparator" parent="Box"]
layout_mode = 2
theme_type_variation = &"Rule"

[node name="Routes" type="VBoxContainer" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 6
