choices = Array[Dictionary]([{"id": "chat", "text_key": "conv.dean_catch_up.chat", "reply_key": "conv.dean_catch_up.chat.reply", "trust": 2.0, "belonging": 8.0, "memory_tag": "talked"}, {"id": "ask", "text_key": "conv.dean_catch_up.ask", "reply_key": "conv.dean_catch_up.ask.reply", "trust": 4.0, "belonging": 6.0, "memory_tag": "asked_after_them", "emotional": true}, {"id": "push", "text_key": "conv.dean_catch_up.push", "reply_key": "conv.dean_catch_up.push.reply", "trust": -2.0, "resentment": 4.0, "memory_tag": "pushed"}])
