[gd_resource type="Resource" script_class="Conversation" load_steps=2 format=3]

[ext_resource type="Script" path="res://content/defs/conversation.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"dean_catch_up"
opener_key = "conv.dean_catch_up.opener"
openers = Array[Dictionary]([{"text_key": "conv.dean_catch_up.opener.1", "when": {"has_memory": "dismissed"}}, {"text_key": "conv.dean_catch_up.opener.2", "when": {"mood": ["low", "tired"]}}, {"text_key": "conv.dean_catch_up.opener.3", "when": {"band": ["warm", "close"]}}])
timer_seconds = 0.0
choices = Array[Dictionary]([{"id": "chat", "text_key": "conv.dean_catch_up.chat", "reply_key": "conv.dean_catch_up.chat.reply", "replies": [{"text_key": "conv.dean_catch_up.chat.reply.1", "when": {"mood": ["skint"]}}], "trust": 2.0, "belonging": 8.0, "memory_tag": "talked"}, {"id": "ask", "text_key": "conv.dean_catch_up.ask", "reply_key": "conv.dean_catch_up.ask.reply", "next": "dean_opens_up", "trust": 3.0, "belonging": 6.0, "memory_tag": "asked_after_them", "emotional": true}, {"id": "push", "text_key": "conv.dean_catch_up.push", "when": {"lacks_memory": "pushed"}, "reply_key": "conv.dean_catch_up.push.reply", "trust": -2.0, "resentment": 4.0, "memory_tag": "pushed"}, {"id": "push_again", "text_key": "conv.dean_catch_up.push_again", "when": {"has_memory": "pushed"}, "reply_key": "conv.dean_catch_up.push_again.reply", "trust": -3.0, "resentment": 6.0, "memory_tag": "pushed"}, {"id": "tip_off", "text_key": "conv.dean_catch_up.tip_off", "when": {"learned": "rumour.council_sale", "lacks_memory": "tipped_off"}, "reply_key": "conv.dean_catch_up.tip_off.reply", "trust": 5.0, "belonging": 4.0, "memory_tag": "tipped_off", "emotional": true}])
