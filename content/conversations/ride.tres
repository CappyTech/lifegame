[gd_resource type="Resource" script_class="Conversation" load_steps=2 format=3]

[ext_resource type="Script" path="res://content/defs/conversation.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"ride"
opener_key = "conv.ride.opener"
timer_seconds = 0.0
choices = Array[Dictionary]([{"id": "chat", "text_key": "conv.ride.chat", "reply_key": "conv.ride.chat.reply", "trust": 3.0, "belonging": 4.0, "memory_tag": "chatted"}, {"id": "ask", "text_key": "conv.ride.ask", "reply_key": "conv.ride.ask.reply", "trust": 4.0, "belonging": 3.0, "memory_tag": "asked"}, {"id": "radio", "text_key": "conv.ride.radio"}])
